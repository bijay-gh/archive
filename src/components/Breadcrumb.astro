---
export interface BreadcrumbItem {
  label: string;
  url: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6 flex">
  <ol class="flex items-center space-x-2 text-sm text-text-muted">
    {items.map((item, index) => (
      <li class="flex items-center">
        {index > 0 && (
          <span class="mx-2 text-border">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </span>
        )}
        {index === items.length - 1 ? (
          <span class="font-medium text-text" aria-current="page">{item.label}</span>
        ) : (
          <a href={item.url} class="hover:text-forest transition-colors duration-200">{item.label}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
