---
import ThemeToggle from "./ThemeToggle.astro";

const today = new Date();
const dateDesktop = today.toLocaleDateString("en-US", {
  weekday: "short",
  year: "numeric",
  month: "short",
  day: "numeric",
});
const dateTablet = today.toLocaleDateString("en-US", {
  weekday: "short",
  year: "numeric",
  month: "long",
  day: "numeric",
});
const dateMobile = today.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/blog/", label: "Blog" },
  { href: "/notes/", label: "Notes" },
  { href: "/reports/", label: "Reports" },
  { href: "/projects/", label: "Projects" },
  { href: "/about/", label: "About" },
];

const currentPath = Astro.url.pathname;
---

<header class="masthead">
  <div class="masthead__inner container mx-auto">
    <!-- Top Row: Date, Title, Toggle (hidden on mobile) -->
    <div
      class="hidden md:grid grid-cols-[1fr_auto_1fr] items-center px-4 gap-2"
    >
      <div class="flex justify-start items-center min-w-0">
        <span class="masthead__date hidden lg:block">{dateDesktop}</span>
        <span class="masthead__date hidden md:block lg:hidden"
          >{dateTablet}</span
        >
      </div>

      <div class="flex justify-center items-center min-w-0">
        <a href="/" class="masthead__title-link">
          <h1 class="masthead__title">The Archive</h1>
        </a>
      </div>

      <div class="flex justify-end items-center">
        <ThemeToggle />
      </div>
    </div>

    <!-- Mobile Top Row: Title Only -->
    <div class="flex md:hidden justify-center items-center px-4">
      <a href="/" class="masthead__title-link">
        <h1 class="masthead__title">The Archive</h1>
      </a>
    </div>

    <!-- Mobile secondary row for Date and Toggle (hidden on desktop/tablet) -->
    <div class="flex md:hidden justify-between items-center px-4 mt-2">
      <div class="flex justify-start items-center min-w-0">
        <span class="masthead__date block">{dateMobile}</span>
      </div>
      <div class="flex justify-end items-center">
        <ThemeToggle />
      </div>
    </div>

    <div class="masthead__rule masthead__rule--bottom"></div>

    <!-- Navigation Row -->
    <nav class="masthead__nav px-2" aria-label="Main navigation">
      <ul
        class="header-nav-list flex md:flex-wrap justify-start md:justify-center items-center gap-2 m-0 p-0 list-none overflow-x-auto md:overflow-x-visible pb-1 md:pb-0"
      >
        {
          navLinks.map((link, index) => (
            <>
              <li class="shrink-0">
                <a
                  href={link.href}
                  class:list={[
                    "masthead__nav-link",
                    {
                      active:
                        currentPath === link.href ||
                        (link.href !== "/" &&
                          currentPath.startsWith(link.href)),
                    },
                  ]}
                >
                  {link.label}
                </a>
              </li>
              {index < navLinks.length - 1 && (
                <li class="header-nav-separator shrink-0" aria-hidden="true">
                  ·
                </li>
              )}
            </>
          ))
        }
      </ul>
    </nav>

    <div class="masthead__rule masthead__rule--nav"></div>
  </div>
</header>

<style>
  .masthead {
    padding-top: var(
      --sp-sm
    ); /* Slightly reduced to keep overall height compact */
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--bg-primary);
    transition:
      transform 0.25s ease,
      background-color 0.25s ease,
      backdrop-filter 0.25s ease;
  }

  .masthead.is-hidden {
    transform: translateY(-100%);
  }

  .masthead.is-scrolled {
    background-color: color-mix(in srgb, var(--bg-primary) 85%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .masthead::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 30px;
    background: transparent;
  }

  @media (prefers-reduced-motion: reduce) {
    .masthead {
      transition: none;
    }
  }

  .masthead__inner {
    text-align: center;
  }

  /* ─── Date Formats ─── */
  .masthead__date {
    font-family: var(--font-label);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ─── Title ─── */
  .masthead__title-link {
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }

  .masthead__title-link:hover {
    color: inherit;
  }

  .masthead__title {
    font-family: var(--font-heading);
    /* Fluid typography that scales down smoothly */
    font-size: clamp(2rem, 5vw, var(--fs-5xl));
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0;
    line-height: 1;
  }

  /* ─── Rules / Borders ─── */
  .masthead__rule--bottom {
    border-top: 3px double var(--border-dark);
    margin-top: var(--sp-sm);
    margin-bottom: var(--sp-sm);
  }

  .masthead__rule--nav {
    border-top: 1px solid var(--border);
    margin-top: var(--sp-sm);
  }

  /* ─── Navigation ─── */
  .header-nav-separator {
    color: var(--text-muted);
    font-size: var(--fs-lg);
    line-height: 1;
    user-select: none;
  }

  .masthead__nav-link {
    font-family: var(--font-label);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
    text-decoration: none;
    padding: var(--sp-xs) 2px;
    transition: color var(--transition-fast);
    white-space: nowrap;
    display: inline-block;
  }

  .masthead__nav-link:hover,
  .masthead__nav-link.active {
    color: var(--accent);
  }

  /* Mobile scrollbar hiding for nav */
  @media (max-width: 768px) {
    .header-nav-list {
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none; /* Firefox */
      -ms-overflow-style: none; /* IE/Edge */
    }

    .header-nav-list::-webkit-scrollbar {
      display: none; /* Chrome/Safari */
    }

    /* Ensure first and last items don't stick to the very edge when scrolling */
    .header-nav-list::before,
    .header-nav-list::after {
      content: "";
      flex: 0 0 var(--sp-xs);
    }
  }
</style>
