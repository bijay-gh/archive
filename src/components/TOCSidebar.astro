---
---
<aside id="toc-sidebar-container" class="toc-sidebar hidden sticky top-24 self-start max-h-[calc(100vh-6rem)] overflow-y-auto pr-4 scrollbar-hide">
  <div class="toc-sidebar__header mb-4 text-xs font-bold tracking-[0.2em] uppercase text-text-muted">
    CONTENTS
  </div>
  <nav class="toc-sidebar__nav">
    <ul id="toc-desktop-list" class="space-y-2 text-sm">
      <!-- Injected by JS -->
    </ul>
  </nav>
</aside>

<!-- Mobile Toggle -->
<div id="toc-mobile-toggle-container" class="hidden fixed bottom-6 right-6 z-50">
  <button id="toc-mobile-toggle" class="bg-forest text-white rounded-full p-4 shadow-lg focus:outline-none flex items-center gap-2 hover:bg-forest/90 transition-colors" aria-label="Toggle Table of Contents">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
  </button>
</div>

<!-- Mobile TOC Overlay -->
<div id="toc-mobile-overlay" class="fixed inset-0 z-40 hidden bg-black/40 backdrop-blur-sm transition-opacity duration-300 opacity-0"></div>

<!-- Mobile TOC Drawer -->
<div id="toc-mobile-drawer" class="fixed inset-y-0 right-0 z-50 w-72 sm:w-80 bg-bg border-l border-border shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
  <div class="flex justify-between items-center p-6 border-b border-border">
    <h2 class="text-xl font-bold text-text">Table of Contents</h2>
    <button id="toc-mobile-close" class="text-text-muted hover:text-text p-2 rounded-full hover:bg-bg-alt transition-colors">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
  </div>
  <nav class="flex-1 overflow-y-auto p-6">
    <ul id="toc-mobile-list" class="space-y-4">
      <!-- Injected by JS -->
    </ul>
  </nav>
</div>

<style>
  .toc-sidebar.scrollbar-hide {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .toc-sidebar.scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .toc-link.is-active, .toc-mobile-link.is-active {
    color: var(--accent);
    font-weight: 600;
  }
  .toc-link.is-active {
    border-left: 2px solid var(--accent);
    padding-left: 0.5rem;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Find all headings inside .article__body
    const articleBody = document.querySelector('.article__body');
    if (!articleBody) return;

    // Only H1 to H4
    const headings = Array.from(articleBody.querySelectorAll('h1, h2, h3, h4'));
    if (headings.length === 0) return;

    // 2. Show the TOC containers since we have headings
    const sidebar = document.getElementById('toc-sidebar-container');
    const mobileToggleContainer = document.getElementById('toc-mobile-toggle-container');
    
    if (sidebar) {
      sidebar.classList.remove('hidden');
      sidebar.classList.add('hidden', 'lg:block'); // Ensure it acts responsive
    }
    if (mobileToggleContainer) {
      mobileToggleContainer.classList.remove('hidden');
      mobileToggleContainer.classList.add('lg:hidden'); // Hidden on desktop
    }

    const desktopList = document.getElementById('toc-desktop-list');
    const mobileList = document.getElementById('toc-mobile-list');

    // Generate IDs if missing, and build TOC lists
    headings.forEach((heading) => {
      if (!heading.id) {
        heading.id = (heading.textContent || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || `h-${Math.random().toString(36).substring(2, 9)}`;
      }

      const depth = parseInt(heading.tagName.replace('H', ''), 10);
      const text = heading.textContent || '';
      
      // Desktop item
      if (desktopList) {
        const li = document.createElement('li');
        li.className = `toc-item toc-depth-${depth}`;
        li.style.marginLeft = `${(depth - 1) * 1}rem`;
        
        const a = document.createElement('a');
        a.href = `#${heading.id}`;
        a.className = 'toc-link block text-text-muted hover:text-text transition-all duration-200';
        a.setAttribute('data-slug', heading.id);
        a.textContent = text;
        
        li.appendChild(a);
        desktopList.appendChild(li);
      }

      // Mobile item
      if (mobileList) {
        const li = document.createElement('li');
        li.style.marginLeft = `${(depth - 1) * 1}rem`;
        
        const a = document.createElement('a');
        a.href = `#${heading.id}`;
        a.className = 'toc-mobile-link block text-lg text-text-muted hover:text-text transition-colors duration-200';
        a.setAttribute('data-slug', heading.id);
        a.textContent = text;
        
        li.appendChild(a);
        mobileList.appendChild(li);
      }
    });

    // 3. Intersection Observer for active heading
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          if (id) {
            document.querySelectorAll('.toc-link, .toc-mobile-link').forEach((link) => {
              link.classList.remove('is-active');
            });
            document.querySelectorAll(`.toc-link[data-slug="${id}"], .toc-mobile-link[data-slug="${id}"]`).forEach(activeLink => {
              activeLink.classList.add('is-active');
            });
          }
        }
      });
    }, { rootMargin: '-10% 0px -80% 0px' });

    headings.forEach((section) => {
      observer.observe(section);
    });

    // 4. Mobile Toggle & Drawer Logic
    const mobileToggle = document.getElementById('toc-mobile-toggle');
    const mobileClose = document.getElementById('toc-mobile-close');
    const mobileOverlay = document.getElementById('toc-mobile-overlay');
    const mobileDrawer = document.getElementById('toc-mobile-drawer');
    
    if (mobileToggle && mobileDrawer && mobileClose && mobileOverlay) {
      const openDrawer = () => {
        mobileOverlay.classList.remove('hidden');
        // Small delay to allow display block to apply before opacity transition
        setTimeout(() => mobileOverlay.classList.remove('opacity-0'), 10);
        mobileDrawer.classList.remove('translate-x-full');
        document.body.classList.add('overflow-hidden');
      };

      const closeDrawer = () => {
        mobileOverlay.classList.add('opacity-0');
        mobileDrawer.classList.add('translate-x-full');
        document.body.classList.remove('overflow-hidden');
        setTimeout(() => mobileOverlay.classList.add('hidden'), 300);
      };

      mobileToggle.addEventListener('click', openDrawer);
      mobileClose.addEventListener('click', closeDrawer);
      mobileOverlay.addEventListener('click', closeDrawer);
      
      // Close drawer when a link is clicked
      mobileDrawer.addEventListener('click', (e) => {
        if (e.target.closest('.toc-mobile-link')) {
          closeDrawer();
        }
      });
    }
  });
</script>
