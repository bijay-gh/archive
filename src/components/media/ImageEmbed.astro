---
interface Props {
  src: string;
  alt?: string;
  caption?: string;
}

const { src, alt = '', caption } = Astro.props;
---

<figure class="media-image">
  <img
    src={src}
    alt={alt}
    loading="lazy"
    decoding="async"
    data-lightbox="true"
    class="media-image__img"
  />
  {caption && <figcaption class="media-caption">{caption}</figcaption>}
</figure>

<style>
  .media-image {
    margin: var(--sp-xl) 0;
    text-align: center;
  }

  .media-image__img {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--border);
    cursor: zoom-in;
    transition: opacity var(--transition-fast);
  }

  .media-image__img:hover {
    opacity: 0.92;
  }

  .media-caption {
    font-family: var(--font-label);
    font-size: var(--fs-xs);
    color: var(--text-muted);
    text-align: center;
    margin-top: var(--sp-sm);
    letter-spacing: 0.04em;
    font-style: italic;
  }
</style>
