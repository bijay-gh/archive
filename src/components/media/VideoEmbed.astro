---
interface Props {
  src?: string;
  url?: string;
  caption?: string;
}

const { src, url, caption } = Astro.props;
const target = url || src || '';

// Detect YouTube
const ytMatch = target.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]{11})/);
const ytId = ytMatch ? ytMatch[1] : null;

// Detect Vimeo
const vimeoMatch = target.match(/vimeo\.com\/(\d+)/);
const vimeoId = vimeoMatch ? vimeoMatch[1] : null;
---

<figure class="media-video">
  <div class="media-video__wrapper media-video__wrapper--16x9">
    {ytId ? (
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${ytId}`}
        title={caption || 'YouTube video'}
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
      ></iframe>
    ) : vimeoId ? (
      <iframe
        src={`https://player.vimeo.com/video/${vimeoId}?dnt=1`}
        title={caption || 'Vimeo video'}
        frameborder="0"
        allow="autoplay; fullscreen; picture-in-picture"
        allowfullscreen
        loading="lazy"
      ></iframe>
    ) : (
      <video controls preload="metadata">
        <source src={target} />
        Your browser does not support the video tag.
      </video>
    )}
  </div>
  {caption && <figcaption class="media-caption">{caption}</figcaption>}
</figure>

<style>
  .media-video {
    margin: var(--sp-xl) 0;
  }

  .media-video__wrapper--16x9 {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 */
    height: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-secondary);
  }

  .media-video__wrapper--16x9 iframe,
  .media-video__wrapper--16x9 video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .media-caption {
    font-family: var(--font-label);
    font-size: var(--fs-xs);
    color: var(--text-muted);
    text-align: center;
    margin-top: var(--sp-sm);
    letter-spacing: 0.04em;
    font-style: italic;
  }
</style>
