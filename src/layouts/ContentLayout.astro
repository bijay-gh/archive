---
import Layout from './Layout.astro';
import TOCSidebar from '../components/TOCSidebar.astro';

export interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  compactHeader?: boolean;
  toc?: boolean;
}

const {
  title,
  description,
  ogType,
  compactHeader,
  toc = false,
} = Astro.props;
---

<Layout title={title} description={description} ogType={ogType} compactHeader={compactHeader}>
  {toc ? (
    <div class="container mx-auto px-4 py-8 max-w-6xl xl:max-w-7xl">
      <div class="flex flex-col lg:flex-row gap-8 relative">
        <main class="flex-grow min-w-0">
          <slot />
        </main>
        <TOCSidebar />
      </div>
    </div>
  ) : (
    <main class="container mx-auto px-4 py-8 max-w-6xl xl:max-w-7xl">
      <slot />
    </main>
  )}
</Layout>
