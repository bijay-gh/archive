---
import Layout from './Layout.astro';
import TOCSidebar from '../components/TOCSidebar.astro';

export interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  compactHeader?: boolean;
  toc?: boolean;
}

const {
  title,
  description,
  ogType,
  compactHeader,
  toc = false,
} = Astro.props;
---

<Layout title={title} description={description} ogType={ogType} compactHeader={compactHeader}>
  {toc ? (
    <div class="container-toc">
      <div class="toc-grid relative">
        <TOCSidebar />
        <main class="min-w-0 w-full">
          <slot />
        </main>
      </div>
    </div>
  ) : (
    <main class="container">
      <slot />
    </main>
  )}
</Layout>
