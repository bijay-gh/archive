---
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import OrnamentalDivider from "../components/OrnamentalDivider.astro";
import { getCollection } from "astro:content";

const allPosts = (await getCollection("posts"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Collect all unique tags
const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags))].sort();
---

<Layout
  title="Random Stuff"
  description="A complete archive of all blog posts and writings."
  compactHeader={true}
>
  <div class="container">
    <header class="archive-header">
      <h1 class="archive-header__title">Random Stuff</h1>
      <p class="archive-header__sub">
        A complete record of dispatches, essays, and musings.
      </p>
      <OrnamentalDivider variant="diamond" />
    </header>

    <!-- Tag Filter -->
    {
      allTags.length > 0 && (
        <nav class="tag-filter" aria-label="Filter by tag">
          <span class="tag-filter__label label">Filter by topic:</span>
          <div class="tag-filter__tags">
            <button
              class="tag tag--active"
              data-filter="all"
              onclick="filterPosts('all')"
            >
              All
            </button>
            {allTags.map((tag) => (
              <button
                class="tag"
                data-filter={tag}
                onclick={`filterPosts('${tag}')`}
              >
                {tag}
              </button>
            ))}
          </div>
        </nav>
      )
    }

    <!-- Posts List -->
    <section class="archive-list" aria-label="Blog posts">
      {
        allPosts.map((post) => (
          <div class="archive-item" data-tags={post.data.tags.join(",")}>
            <PostCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              href={`/posts/${post.id}/`}
              tags={post.data.tags}
              format={post.data.format}
              media={post.data.media}
            />
          </div>
        ))
      }
    </section>

    {
      allPosts.length === 0 && (
        <p class="archive-empty">No posts published yet. Check back soon.</p>
      )
    }

    <OrnamentalDivider variant="floral" />
  </div>
</Layout>

<script is:inline>
  function filterPosts(tag) {
    const items = document.querySelectorAll(".archive-item");
    const buttons = document.querySelectorAll(".tag-filter__tags .tag");

    buttons.forEach((btn) => {
      btn.classList.toggle(
        "tag--active",
        btn.getAttribute("data-filter") === tag
      );
    });

    items.forEach((item) => {
      if (tag === "all") {
        item.style.display = "";
      } else {
        const tags = item.getAttribute("data-tags") || "";
        item.style.display = tags.split(",").includes(tag) ? "" : "none";
      }
    });
  }
</script>

<style>
  .archive-header {
    text-align: center;
    padding-top: var(--sp-md);
  }

  .archive-header__title {
    font-size: var(--fs-4xl);
    margin-bottom: var(--sp-sm);
  }

  .archive-header__sub {
    font-family: var(--font-body);
    font-size: var(--fs-lg);
    color: var(--text-muted);
    font-style: italic;
    margin: 0;
  }

  .tag-filter {
    margin-bottom: var(--sp-xl);
    text-align: center;
  }

  .tag-filter__label {
    display: block;
    margin-bottom: var(--sp-sm);
  }

  .tag-filter__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-xs);
  }

  .tag-filter__tags .tag {
    cursor: pointer;
    font-family: var(--font-label);
    background: none;
  }

  .archive-list {
    max-width: var(--max-width-content);
    margin: 0 auto;
  }

  .archive-empty {
    text-align: center;
    color: var(--text-muted);
    font-style: italic;
    padding: var(--sp-3xl) 0;
  }
</style>
