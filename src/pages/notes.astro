---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import OrnamentalDivider from '../components/OrnamentalDivider.astro';
import { getCollection } from 'astro:content';
import { getListedContent } from '../utils/contentFilter';

const allNotes = (await getListedContent('notes'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const subjects = [...new Set(allNotes.map(n => n.data.subject))].sort();
---

<Layout title="Study Notes" description="A collection of study notes, learning materials, and reference documents." compactHeader={true}>
  <div class="container">

    <header class="page-header">
      <h1 class="page-header__title">Study Notes</h1>
      <p class="page-header__sub">From the study — notes, references, and learning materials.</p>
      <OrnamentalDivider variant="rule" />
    </header>

    <div class="filter-controls">
      <input type="search" id="notes-search" class="search-input" placeholder="Search notes..." oninput="filterNotes()" />
    </div>

    {subjects.length > 1 && (
      <nav class="subject-nav" aria-label="Filter by subject">
        <span class="label">Subjects:</span>
        <span class="subject-list">
          <button class="tag tag--active" data-subject="all" onclick="filterNotes('all')">All</button>
          {subjects.map(subject => (
            <button class="tag" data-subject={subject} onclick={`filterNotes('${subject}')`}>{subject}</button>
          ))}
        </span>
      </nav>
    )}

    <section class="archive-list" aria-label="Study notes">
      {allNotes.map(note => (
        <div class="archive-item" data-subject={note.data.subject} data-title={note.data.title.toLowerCase()}>
          <div class="archive-item__meta">
            <span class="category-label category-label--forest">{note.data.subject}</span>
          </div>
          <PostCard
            title={note.data.title}
            description={note.data.description}
            pubDate={note.data.pubDate}
            href={`/notes/${note.id}/`}
            tags={note.data.tags}
            format={note.data.format}
            media={note.data.media}
          />
        </div>
      ))}
    </section>

    {allNotes.length === 0 && (
      <p class="archive-empty">No notes published yet. Check back soon.</p>
    )}

    <OrnamentalDivider variant="floral" />
  </div>
</Layout>

<script is:inline>
  let currentSubject = 'all';

  function filterNotes(subject) {
    if (subject !== undefined) {
      currentSubject = subject;
      const buttons = document.querySelectorAll('.subject-list .tag');
      buttons.forEach(btn => {
        btn.classList.toggle('tag--active', btn.getAttribute('data-subject') === subject);
      });
    }

    const searchQuery = (document.getElementById('notes-search')?.value || '').toLowerCase();
    const items = document.querySelectorAll('.archive-item');

    items.forEach(item => {
      const itemSubject = item.getAttribute('data-subject');
      const itemTitle = item.getAttribute('data-title') || '';
      
      const matchesSubject = currentSubject === 'all' || itemSubject === currentSubject;
      const matchesSearch = itemTitle.includes(searchQuery);

      if (matchesSubject && matchesSearch) {
        item.style.display = '';
      } else {
        item.style.display = 'none';
      }
    });
  }
</script>

<style>
  .page-header {
    text-align: center;
    padding-top: var(--sp-md);
  }

  .page-header__title {
    font-size: var(--fs-4xl);
    margin-bottom: var(--sp-sm);
  }

  .page-header__sub {
    font-family: var(--font-body);
    font-size: var(--fs-lg);
    color: var(--text-muted);
    font-style: italic;
    margin: 0;
  }

  .subject-nav {
    text-align: center;
    margin-bottom: var(--sp-xl);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--sp-sm);
    flex-wrap: wrap;
  }

  .subject-list {
    display: flex;
    gap: var(--sp-xs);
    flex-wrap: wrap;
  }

  .archive-list {
    width: 100%;
    margin: 0 auto;
  }

  .archive-item__meta {
    padding-top: var(--sp-lg);
  }

  .archive-empty {
    text-align: center;
    color: var(--text-muted);
    font-style: italic;
    padding: var(--sp-3xl) 0;
  }

  .filter-controls {
    text-align: center;
    margin-bottom: var(--sp-md);
  }

  .search-input {
    width: 100%;
    max-width: 400px;
    padding: var(--sp-sm) var(--sp-md);
    font-family: var(--font-body);
    font-size: var(--fs-base);
    color: var(--text-primary);
    background: var(--bg-card);
    border: 1px solid var(--border);
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .search-input:focus {
    border-color: var(--accent);
  }

  .subject-list .tag {
    cursor: pointer;
    background: none;
  }
</style>
