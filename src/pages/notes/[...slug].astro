---
import ContentLayout from '../../layouts/ContentLayout.astro';
import OrnamentalDivider from '../../components/OrnamentalDivider.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { render } from 'astro:content';
import { getFilePath, parseDocx, parseTex } from '../../utils/fileParser';
import { getAllContent, getParentPage } from '../../utils/contentFilter';
import fs from 'node:fs';

export async function getStaticPaths() {
  const notes = await getAllContent('notes');
  return notes.map(note => {
    let slug = note.id;
    if (note.data.parent) {
      slug = `${note.data.parent}/${note.id}`;
    }
    return {
      params: { slug },
      props: { note },
    };
  });
}

const { note } = Astro.props;
const format = note.data.format || 'md';

let Content;
let htmlContent = '';

try {
  const rendered = await render(note);
  Content = rendered?.Content;
} catch (e) {
  // If it's a JSON file, render might fail, which is fine.
}

if (format === 'docx' && note.data.file) {
  htmlContent = await parseDocx(getFilePath('notes', note.data.file));
} else if (format === 'tex' && note.data.file) {
  htmlContent = parseTex(getFilePath('notes', note.data.file));
}

const wordCount = note.body ? note.body.split(/\s+/).length : (htmlContent ? htmlContent.replace(/<[^>]*>?/gm, '').split(/\s+/).length : 0);
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const dateStr = note.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

let breadcrumbItems = [{ label: 'Notes', url: '/notes/' }];
if (note.data.parent) {
  const parent = await getParentPage('notes', note.data.parent);
  if (parent) {
    breadcrumbItems.push({ label: parent.data.title, url: `/notes/${parent.id}` });
  }
}
breadcrumbItems.push({ label: note.data.title, url: '#' });

---

<ContentLayout 
  title={note.data.title} 
  description={note.data.description} 
  ogType="article" 
  compactHeader={true}
  toc={note.data.toc}
>
  <article class="article container">
    {note.data.parent && <Breadcrumb items={breadcrumbItems} />}
    
    <header class="article__header">
      <span class="category-label category-label--forest">{note.data.subject}</span>
      <h1 class="article__title">{note.data.title}</h1>
      <div class="article__meta label">
        <time datetime={note.data.pubDate.toISOString()}>{dateStr}</time>
        <span class="article__sep">·</span>
        <span>{readingTime} min read</span>
      </div>
    </header>
    <OrnamentalDivider variant="rule" />
    <div class="article__body prose drop-cap w-full max-w-none">
      {Content && <Content />}
      {format === 'docx' && <div set:html={htmlContent} />}
      {format === 'tex' && <div set:html={htmlContent} />}
      {format === 'pdf' && note.data.file && (
        <iframe src={`/assets/notes/${note.data.file}`} class="pdf-viewer" title={note.data.title}></iframe>
      )}
    </div>
    <OrnamentalDivider variant="floral" />
    <footer class="article__footer">
      <a href="/notes/" class="btn btn--alt">← Back to Notes</a>
    </footer>
  </article>
</ContentLayout>

<style>
  .article { padding: var(--sp-xl) 0 var(--sp-2xl); width: 100%; }
  .article__header { text-align: center; margin-bottom: var(--sp-md); }
  .article__title { font-size: var(--fs-4xl); margin: var(--sp-sm) 0 var(--sp-md); line-height: 1.15; }
  .article__meta { display: flex; justify-content: center; gap: var(--sp-sm); flex-wrap: wrap; }
  .article__sep { color: var(--text-muted); }
  .article__footer { text-align: center; padding-top: var(--sp-xl); }
  @media (max-width: 600px) { .article__title { font-size: var(--fs-2xl); } }
  .pdf-viewer { width: 100%; height: 80vh; border: 1px solid var(--border); border-radius: 4px; }
</style>
