---
import ContentLayout from '../../layouts/ContentLayout.astro';
import OrnamentalDivider from '../../components/OrnamentalDivider.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { render } from 'astro:content';
import { getFilePath, parseDocx, parseTex } from '../../utils/fileParser';
import { getAllContent, getParentPage } from '../../utils/contentFilter';

export async function getStaticPaths() {
  const projects = await getAllContent('projects');
  return projects.map(project => {
    let slug = project.id;
    if (project.data.parent) {
      slug = `${project.data.parent}/${project.id}`;
    }
    return {
      params: { slug },
      props: { project },
    };
  });
}

const { project } = Astro.props;
const format = project.data.format || 'md';

let Content;
let htmlContent = '';

try {
  const rendered = await render(project);
  Content = rendered?.Content;
} catch (e) {
  // If it's a JSON file, render might fail, which is fine.
}

if (format === 'docx' && project.data.file) {
  htmlContent = await parseDocx(getFilePath('projects', project.data.file));
} else if (format === 'tex' && project.data.file) {
  htmlContent = parseTex(getFilePath('projects', project.data.file));
}

const wordCount = project.body ? project.body.split(/\s+/).length : (htmlContent ? htmlContent.replace(/<[^>]*>?/gm, '').split(/\s+/).length : 0);
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const dateStr = project.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const statusLabel = project.data.status.replace('-', ' ');

let breadcrumbItems = [{ label: 'Projects', url: '/projects/' }];
if (project.data.parent) {
  const parent = await getParentPage('projects', project.data.parent);
  if (parent) {
    breadcrumbItems.push({ label: parent.data.title, url: `/projects/${parent.id}` });
  }
}
breadcrumbItems.push({ label: project.data.title, url: '#' });
---

<ContentLayout 
  title={project.data.title} 
  description={project.data.description} 
  ogType="article" 
  compactHeader={true}
  toc={project.data.toc}
>
  <article class="article container">
    {project.data.parent && <Breadcrumb items={breadcrumbItems} />}
    
    <header class="article__header">
      <div class="article__badges">
        <span class="category-label">Project</span>
        <span class:list={['status-badge', `status-badge--${project.data.status}`]}>{statusLabel}</span>
      </div>
      <h1 class="article__title">{project.data.title}</h1>
      <div class="article__meta label">
        <time datetime={project.data.pubDate.toISOString()}>{dateStr}</time>
        <span class="article__sep">·</span>
        <span>{readingTime} min read</span>
      </div>
      {project.data.url && (
        <a href={project.data.url} target="_blank" rel="noopener" class="btn project-link">
          View Project →
        </a>
      )}
    </header>
    <OrnamentalDivider variant="stars" compact={true} />
    <div class="article__body prose">
      {Content && <Content />}
      {format === 'docx' && <div set:html={htmlContent} />}
      {format === 'tex' && <div set:html={htmlContent} />}
      {format === 'pdf' && project.data.file && (
        <iframe src={`/assets/projects/${project.data.file}`} class="pdf-viewer" title={project.data.title}></iframe>
      )}
    </div>
    <OrnamentalDivider variant="floral" />
    <footer class="article__footer">
      <a href="/projects/" class="btn">← Back to Projects</a>
    </footer>
  </article>
</ContentLayout>

<style>
  .article { padding: var(--sp-md) 0 var(--sp-xl); width: 100%; max-width: 100%; }
  .article__header { text-align: center; margin-bottom: var(--sp-xs); }
  .article__badges { display: flex; justify-content: center; gap: var(--sp-sm); align-items: center; }
  .article__title { font-size: var(--fs-2xl); margin: var(--sp-xs) 0; line-height: 1.1; }
  .article__meta { display: flex; justify-content: center; align-items: center; gap: var(--sp-xs); flex-wrap: wrap; margin-bottom: var(--sp-xs); font-size: 0.65rem; opacity: 0.7; }
  .article__sep { color: var(--text-muted); font-size: 0.5rem; }
  .article__footer { text-align: center; padding-top: var(--sp-xl); }
  .status-badge {
    font-family: var(--font-label);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.2em 0.6em;
    border: 1px solid var(--accent-alt);
    color: var(--accent-alt);
  }
  .status-badge--completed { border-color: var(--accent); color: var(--accent); }
  .status-badge--archived { border-color: var(--text-muted); color: var(--text-muted); }
  .project-link { margin-top: var(--sp-sm); }
  @media (max-width: 600px) { .article__title { font-size: var(--fs-xl); } }
  .pdf-viewer { width: 100%; height: 92vh; border: 1px solid var(--border); }
</style>
