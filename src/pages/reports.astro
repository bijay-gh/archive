---
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import OrnamentalDivider from "../components/OrnamentalDivider.astro";
import { getCollection } from "astro:content";
import { getListedContent } from "../utils/contentFilter";

const allReports = (await getListedContent("reports"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Reports"
  description="Long-form reports, analyses, and essays."
  compactHeader={true}
>
  <div class="container">
    <header class="page-header">
      <h1 class="page-header__title">Reports</h1>
      <p class="page-header__sub">
        In-depth analyses, investigations, and long-form writing.
      </p>
      <OrnamentalDivider variant="section" />
    </header>

    <div class="filter-controls">
      <input type="search" id="reports-search" class="search-input" placeholder="Search reports..." oninput="filterReports()" />
    </div>

    <section class="archive-list">
      {
        allReports.map((report) => (
          <div class="archive-item" data-title={report.data.title.toLowerCase()}>
            <PostCard
            title={report.data.title}
            description={report.data.description}
            pubDate={report.data.pubDate}
            href={`/reports/${report.id}/`}
            tags={report.data.tags}
            format={report.data.format}
            media={report.data.media}
          />
          </div>
        ))
      }
    </section>
    {allReports.length === 0 && <p class="empty">No reports published yet.</p>}
    <OrnamentalDivider variant="floral" />
  </div>
</Layout>

<script is:inline>
  function filterReports() {
    const searchQuery = (document.getElementById('reports-search')?.value || '').toLowerCase();
    const items = document.querySelectorAll('.archive-item');

    items.forEach(item => {
      const itemTitle = item.getAttribute('data-title') || '';
      if (itemTitle.includes(searchQuery)) {
        item.style.display = '';
      } else {
        item.style.display = 'none';
      }
    });
  }
</script>

<style>
  .page-header {
    text-align: center;
    padding-top: var(--sp-md);
  }
  .page-header__title {
    font-size: var(--fs-4xl);
    margin-bottom: var(--sp-sm);
  }
  .page-header__sub {
    font-size: var(--fs-lg);
    color: var(--text-muted);
    font-style: italic;
    margin: 0;
  }
  .archive-list {
    width: 100%;
    margin: 0 auto;
  }
  .empty {
    text-align: center;
    color: var(--text-muted);
    font-style: italic;
    padding: var(--sp-3xl) 0;
  }

  .filter-controls {
    text-align: center;
    margin-bottom: var(--sp-lg);
  }

  .search-input {
    width: 100%;
    max-width: 400px;
    padding: var(--sp-sm) var(--sp-md);
    font-family: var(--font-body);
    font-size: var(--fs-base);
    color: var(--text-primary);
    background: var(--bg-card);
    border: 1px solid var(--border);
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .search-input:focus {
    border-color: var(--accent);
  }
</style>
