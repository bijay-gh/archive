---
import ContentLayout from '../../layouts/ContentLayout.astro';
import OrnamentalDivider from '../../components/OrnamentalDivider.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { render } from 'astro:content';
import { getFilePath, parseDocx, parseTex } from '../../utils/fileParser';
import { getAllContent, getParentPage } from '../../utils/contentFilter';

export async function getStaticPaths() {
  const reports = await getAllContent('reports');
  return reports.map(report => {
    let slug = report.id;
    if (report.data.parent) {
      slug = `${report.data.parent}/${report.id}`;
    }
    return {
      params: { slug },
      props: { report },
    };
  });
}

const { report } = Astro.props;
const format = report.data.format || 'md';

let Content;
let htmlContent = '';

try {
  const rendered = await render(report);
  Content = rendered?.Content;
} catch (e) {
  // If it's a JSON file, render might fail, which is fine.
}

if (format === 'docx' && report.data.file) {
  htmlContent = await parseDocx(getFilePath('reports', report.data.file));
} else if (format === 'tex' && report.data.file) {
  htmlContent = parseTex(getFilePath('reports', report.data.file));
}

const wordCount = report.body ? report.body.split(/\s+/).length : (htmlContent ? htmlContent.replace(/<[^>]*>?/gm, '').split(/\s+/).length : 0);
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const dateStr = report.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

let breadcrumbItems = [{ label: 'Reports', url: '/reports/' }];
if (report.data.parent) {
  const parent = await getParentPage('reports', report.data.parent);
  if (parent) {
    breadcrumbItems.push({ label: parent.data.title, url: `/reports/${parent.id}` });
  }
}
breadcrumbItems.push({ label: report.data.title, url: '#' });
---

<ContentLayout 
  title={report.data.title} 
  description={report.data.description} 
  ogType="article" 
  compactHeader={true}
  toc={report.data.toc}
>
  <article class="article container">
    {report.data.parent && <Breadcrumb items={breadcrumbItems} />}
    
    <header class="article__header">
      <span class="category-label">Report</span>
      <h1 class="article__title">{report.data.title}</h1>
      <div class="article__meta label">
        <time datetime={report.data.pubDate.toISOString()}>{dateStr}</time>
        <span class="article__sep">·</span>
        <span>{report.data.author}</span>
        <span class="article__sep">·</span>
        <span>{readingTime} min read</span>
      </div>
    </header>
    <OrnamentalDivider variant="section" compact={true} />
    <div class="article__body prose">
      {Content && <Content />}
      {format === 'docx' && <div set:html={htmlContent} />}
      {format === 'tex' && <div set:html={htmlContent} />}
      {format === 'pdf' && report.data.file && (
        <iframe src={`/assets/reports/${report.data.file}`} class="pdf-viewer" title={report.data.title}></iframe>
      )}
    </div>
    <OrnamentalDivider variant="floral" />
    <footer class="article__footer">
      <a href="/reports/" class="btn">← Back to Reports</a>
    </footer>
  </article>
</ContentLayout>

<style>
  .article { padding: var(--sp-md) 0 var(--sp-xl); width: 100%; max-width: 100%; }
  .article__header { text-align: center; margin-bottom: var(--sp-xs); }
  .article__title { font-size: var(--fs-2xl); margin: var(--sp-xs) 0; line-height: 1.1; }
  .article__meta { display: flex; justify-content: center; align-items: center; gap: var(--sp-xs); flex-wrap: wrap; margin-bottom: var(--sp-xs); font-size: 0.65rem; opacity: 0.7; }
  .article__sep { color: var(--text-muted); font-size: 0.5rem; }
  .article__footer { text-align: center; padding-top: var(--sp-xl); }
  @media (max-width: 600px) { .article__title { font-size: var(--fs-xl); } }
  .pdf-viewer { width: 100%; height: 92vh; border: 1px solid var(--border); }
</style>
